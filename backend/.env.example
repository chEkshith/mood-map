GROQ_API_KEY=your_api_key_here
GOOGLE_PLACES_API_KEY=
# Use mongodb+srv://... for Atlas (add your IP to Atlas Network Access) or
# mongodb://127.0.0.1:27017 for a local MongoDB.
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
MONGODB_DB_NAME=moodmap
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
SENTRY_DSN=
# Use "production" on Render. This enables Secure + SameSite=None auth cookies
# so the Vercel frontend can authenticate against the Render API.
ENVIRONMENT=local
# Comma-separated list is supported. On Render use the exact Vercel URL, e.g.
# https://mood-map.vercel.app (no trailing slash).
FRONTEND_URL=http://localhost:5173
